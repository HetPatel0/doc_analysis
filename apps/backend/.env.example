MISTRAL_API_KEY=
MISTRAL_MODEL=open-mistral-nemo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOOKIFY_API_SECRET=replace-with-a-random-32-plus-character-secret
BOOKIFY_MAX_UPLOAD_MB=20
# Postgres + pgvector (Neon). Same database as the frontend; the backend owns
# the document_index and document_chunk tables.
DATABASE_URL=
BOOKIFY_STORE=postgres
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_FETCH_K=16
RAG_RETRIEVAL_TOP_K=5
BOOKIFY_STORAGE_DIR=
BOOKIFY_UPLOADS_DIR=
BOOKIFY_VECTORSTORES_DIR=
BOOKIFY_WARM_ON_STARTUP=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# OCR fallback for scanned PDFs.
# auto = local tesseract, then Mistral OCR (needs MISTRAL_API_KEY), then fail.
# mistral / tesseract = force one engine. off = disable OCR.
OCR_PROVIDER=auto
OCR_MIN_CHARS_PER_PAGE=100
OCR_MAX_PAGES=40
OCR_MODEL=mistral-ocr-latest
OCR_LANG=eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=120
